<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_template_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.template.form.spreadsheet</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form" />
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="spreadsheet_id" options="{'no_create': True}" />
                <button
                    name="action_open_spreadsheet_calculator"
                    type="object"
                    class="btn-link"
                    icon="fa-external-link"
                    invisible="not spreadsheet_id"
                >
                    <span>Open Calculator</span>
                </button>
                <button
                    name="action_create_spreadsheet_calculator"
                    type="object"
                    class="btn-link"
                    icon="fa-plus"
                    invisible="spreadsheet_id"
                >
                    <span>Create Calculator</span>
                </button>
            </field>
        </field>
    </record>
</odoo>
