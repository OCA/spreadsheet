<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="spreadsheet_quotation.FieldSyncPanel" owl="1">
        <div class="o_field_sync_panel p-2">
            <div class="o-section">
                <div class="o-section-title mb-2">Column Mappings</div>
                <p class="text-muted small">
                    Map spreadsheet columns to sale order line fields.
                    Existing lines will be updated in place; new rows with
                    product data will be added as new quotation lines.
                </p>
            </div>

            <div class="o-section" t-if="!hasSOList">
                <div class="alert alert-warning small">
                    No sale order line list found in this spreadsheet.
                </div>
            </div>

            <t t-if="hasSOList">
                <div class="o-section" t-if="orderId">
                    <div class="small text-muted mb-2">
                        <i class="fa fa-link me-1" />
                        Linked to Sale Order #<t t-esc="orderId" />
                    </div>
                </div>
                <div class="o-section" t-if="!orderId">
                    <div class="alert alert-info small">
                        Set the Sale Order filter to link this calculator to an order.
                    </div>
                </div>

                <div class="o-section" t-if="mappings.length">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Column</th>
                                <th>Field</th>
                                <th />
                            </tr>
                        </thead>
                        <tbody>
                            <t
                                t-foreach="mappings"
                                t-as="mapping"
                                t-key="mapping_index"
                            >
                                <tr>
                                    <td>
                                        <t t-esc="mapping.column" />
                                    </td>
                                    <td>
                                        <t t-esc="getFieldLabel(mapping.field)" />
                                    </td>
                                    <td>
                                        <button
                                            class="btn btn-sm btn-outline-danger"
                                            t-on-click="() => this.removeMapping(mapping_index)"
                                        >
                                            <i class="fa fa-trash" />
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div class="o-section" t-if="!mappings.length">
                    <p class="text-muted small">No mappings configured yet.</p>
                </div>

                <div class="o-section border-top pt-2 mt-2">
                    <div class="o-section-title mb-2">Add Mapping</div>
                    <div class="d-flex gap-2 align-items-end mb-2">
                        <div class="flex-grow-1">
                            <label class="small">Column</label>
                            <select
                                class="o_input form-select form-select-sm"
                                t-model="state.newColumn"
                            >
                                <option value="">Select...</option>
                                <t t-foreach="availableColumns" t-as="col" t-key="col">
                                    <option t-att-value="col">
                                        <t t-esc="col" />
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="flex-grow-1">
                            <label class="small">Field</label>
                            <select
                                class="o_input form-select form-select-sm"
                                t-model="state.newField"
                            >
                                <option value="">Select...</option>
                                <t t-foreach="syncableFields" t-as="f" t-key="f.name">
                                    <option t-att-value="f.name">
                                        <t t-esc="f.label" />
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                    <button
                        class="btn btn-sm btn-primary"
                        t-on-click="addMapping"
                        t-att-disabled="!state.newColumn || !state.newField"
                    >
                        <i class="fa fa-plus me-1" />Add
                    </button>
                </div>

                <div class="o-section border-top pt-2 mt-2" t-if="hasProductMapping">
                    <div class="alert alert-info small mb-0">
                        <i class="fa fa-info-circle me-1" />
                        <strong>Product sync enabled.</strong>
                        New rows with a product name will be added as new
                        quotation lines. If a product is not found in the
                        catalog you will be asked to confirm its creation.
                    </div>
                </div>

                <div class="o-section border-top pt-3 mt-3">
                    <button
                        class="btn btn-success w-100"
                        t-on-click="saveToSaleOrder"
                        t-att-disabled="state.saving || !orderId || !mappings.length"
                    >
                        <i class="fa fa-refresh me-1" />
                        <t t-if="state.saving">Syncing...</t>
                        <t t-else="">Sync to Sale Order</t>
                    </button>
                </div>
            </t>
        </div>
    </t>

</templates>
