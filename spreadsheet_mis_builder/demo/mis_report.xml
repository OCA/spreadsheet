<odoo noupdate="1">
    <record id="mis_report_style_total" model="mis.report.style">
        <field name="name">Spreadsheet demo total</field>
        <field name="font_weight_inherit" eval="False" />
        <field name="font_weight">bold</field>
        <field name="background_color_inherit" eval="False" />
        <field name="background_color">#E6F2F3</field>
    </record>
    <record id="mis_report_demo" model="mis.report">
        <field name="name">Spreadsheet demo P&amp;L</field>
    </record>
    <record id="mis_report_demo_kpi_revenue" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_demo" />
        <field name="name">revenue</field>
        <field name="description">Revenue</field>
        <field name="expression">-balp[SMB700]</field>
        <field name="sequence">10</field>
    </record>
    <record id="mis_report_demo_kpi_cost" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_demo" />
        <field name="name">cost</field>
        <field name="description">Cost of revenue</field>
        <field name="expression">balp[SMB600]</field>
        <field name="sequence">20</field>
    </record>
    <record id="mis_report_demo_kpi_gross" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_demo" />
        <field name="name">gross_profit</field>
        <field name="description">Gross profit</field>
        <field name="expression">revenue - cost</field>
        <field name="style_id" ref="mis_report_style_total" />
        <field name="sequence">30</field>
    </record>
    <record id="mis_report_demo_kpi_expenses" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_demo" />
        <field name="name">expenses</field>
        <field name="description">Operating expenses</field>
        <field name="expression">balp[SMB610]</field>
        <field name="sequence">40</field>
    </record>
    <record id="mis_report_demo_kpi_net" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_demo" />
        <field name="name">net_profit</field>
        <field name="description">Net profit</field>
        <field name="expression">gross_profit - expenses</field>
        <field name="style_id" ref="mis_report_style_total" />
        <field name="sequence">50</field>
    </record>
    <record id="mis_report_demo_kpi_margin" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_demo" />
        <field name="name">margin</field>
        <field name="description">Net margin</field>
        <field name="expression">net_profit / revenue</field>
        <field name="type">pct</field>
        <field name="sequence">60</field>
    </record>
    <record id="mis_report_demo_kpi_receivable" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_demo" />
        <field name="name">receivable</field>
        <field name="description">Receivables (end balance)</field>
        <field name="expression">bale[SMB400]</field>
        <field name="compare_method">diff</field>
        <field name="sequence">70</field>
    </record>

    <record id="mis_report_instance_demo" model="mis.report.instance">
        <field name="name">Spreadsheet demo P&amp;L by month</field>
        <field name="report_id" ref="mis_report_demo" />
        <field name="comparison_mode" eval="True" />
    </record>
    <record id="mis_report_instance_demo_previous" model="mis.report.instance.period">
        <field name="name">Previous month</field>
        <field name="report_instance_id" ref="mis_report_instance_demo" />
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-1</field>
        <field name="sequence">10</field>
    </record>
    <record id="mis_report_instance_demo_current" model="mis.report.instance.period">
        <field name="name">Current month</field>
        <field name="report_instance_id" ref="mis_report_instance_demo" />
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="sequence">20</field>
    </record>
    <record id="mis_report_instance_demo_ytd" model="mis.report.instance.period">
        <field name="name">Year to date</field>
        <field name="report_instance_id" ref="mis_report_instance_demo" />
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="is_ytd" eval="True" />
        <field name="sequence">30</field>
    </record>
    <record id="mis_report_instance_demo_variation" model="mis.report.instance.period">
        <field name="name">Variation</field>
        <field name="report_instance_id" ref="mis_report_instance_demo" />
        <field name="mode">none</field>
        <field name="source">cmpcol</field>
        <field name="source_cmpcol_from_id" ref="mis_report_instance_demo_previous" />
        <field name="source_cmpcol_to_id" ref="mis_report_instance_demo_current" />
        <field name="sequence">40</field>
    </record>

    <!-- The spreadsheet a user gets from the Spreadsheet button of the report -->
    <function
        model="mis.report.instance"
        name="action_export_spreadsheet"
        eval="[[ref('mis_report_instance_demo')]]"
    />
</odoo>
