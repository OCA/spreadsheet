    </record>
    <function model="account.move" name="action_post">
        <value
            eval="[
                ref('account_move_demo_sales_m2'),
                ref('account_move_demo_cost_m2'),
                ref('account_move_demo_expenses_m2'),
                ref('account_move_demo_sales_m1'),
                ref('account_move_demo_cost_m1'),
                ref('account_move_demo_expenses_m1'),
                ref('account_move_demo_sales_m0'),
                ref('account_move_demo_cost_m0'),
                ref('account_move_demo_expenses_m0'),
            ]"
        />
    </function>
</odoo>
