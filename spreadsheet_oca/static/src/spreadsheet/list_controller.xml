<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web.ListView" t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="inside">
            <t t-if="!editedRecord">
                <button
                    type="button"
                    class="btn btn-secondary fa fa-table ms-1 o_list_button_add_spreadsheet"
                    t-on-click="onClickAddToSpreadsheet"
                    data-tooltip="Add to spreadsheet"
                    aria-label="Add to spreadsheet"
                />
            </t>
        </xpath>
    </t>
</templates>
