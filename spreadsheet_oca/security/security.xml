<odoo>
    <record id="module_category_spreedsheet" model="ir.module.category">
        <field name="name">Spreadsheet</field>
        <field name="sequence" eval="99" />
    </record>
    <record id="privilege_spreadsheet" model="res.groups.privilege">
        <field name="name">Spreadsheet</field>
        <field name="category_id" ref="module_category_spreedsheet" />
        <field name="sequence" eval="99" />
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_spreadsheet" />
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_spreadsheet" />
        <field name="implied_ids" eval="[(4, ref('group_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
