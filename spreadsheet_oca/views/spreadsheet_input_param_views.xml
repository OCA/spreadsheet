<odoo>
    <!-- ── Search view ───────────────────────────────────────────── -->
    <record model="ir.ui.view" id="spreadsheet_input_param_search_view">
        <field name="name">spreadsheet.input_param.search</field>
        <field name="model">spreadsheet.input_param</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="spreadsheet_id" />
                <separator />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="by_spreadsheet"
                        string="Spreadsheet"
                        context="{'group_by': 'spreadsheet_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- ── List view ─────────────────────────────────────────────── -->
    <record model="ir.ui.view" id="spreadsheet_input_param_list_view">
        <field name="name">spreadsheet.input_param.list</field>
        <field name="model">spreadsheet.input_param</field>
        <field name="arch" type="xml">
            <list string="Input Parameters" decoration-muted="not active">
                <field name="name" />
                <field name="spreadsheet_id" />
                <field name="cell_ref" string="Cell" />
                <field name="current_value" string="Current Value" />
                <field name="last_synced" string="Last Synced" />
                <field name="description" />
                <field name="active" column_invisible="True" />
                <button
                    name="action_sync_now"
                    type="object"
                    string="Sync"
                    icon="fa-refresh"
                    title="Read the current cell value from the spreadsheet"
                />
            </list>
        </field>
    </record>

    <!-- ── Form view ─────────────────────────────────────────────── -->
    <record model="ir.ui.view" id="spreadsheet_input_param_form_view">
        <field name="name">spreadsheet.input_param.form</field>
        <field name="model">spreadsheet.input_param</field>
        <field name="arch" type="xml">
            <form string="Input Parameter">
                <header>
                    <button
                        name="action_sync_now"
                        type="object"
                        string="Sync Now"
                        class="btn-primary"
                        title="Read the current cell value from the spreadsheet"
                    />
                    <field name="active" invisible="1" />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="spreadsheet_id" />
                        </group>
                        <group>
                            <field name="cell_ref" string="Cell Reference" />
                            <field name="current_value" readonly="1" />
                            <field name="last_synced" readonly="1" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="description"
                            placeholder="Optional: what does this parameter control?"
                        />
                    </group>
                    <group string="Usage">
                        <div colspan="2" class="text-muted" style="padding:8px 0">
                            Reference this parameter in a pivot or list domain using
                            the percent-name-s token syntax, e.g. the start_date parameter
                            would be substituted as a string value in the domain
                            [("date", "&gt;=", "...")].
                            The value is auto-synced from the linked cell before
                            each scheduled refresh.
                        </div>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────── -->
    <record model="ir.actions.act_window" id="spreadsheet_input_param_act_window">
        <field name="name">Input Parameters</field>
        <field name="res_model">spreadsheet.input_param</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- ── Menu item ─────────────────────────────────────────────── -->
    <record model="ir.ui.menu" id="spreadsheet_input_param_menu">
        <field name="name">Input Parameters</field>
        <field
            name="parent_id"
            ref="spreadsheet_oca.spreadsheet_spreadsheet_configuration_menu"
        />
        <field name="action" ref="spreadsheet_input_param_act_window" />
        <field name="groups_id" eval="[(4, ref('spreadsheet_oca.group_manager'))]" />
        <field name="sequence" eval="24" />
    </record>

    <!-- ── Smart button on spreadsheet form ─────────────────────── -->
    <record model="ir.ui.view" id="spreadsheet_spreadsheet_input_param_button">
        <field name="name">spreadsheet.spreadsheet.form.input_param</field>
        <field name="model">spreadsheet.spreadsheet</field>
        <field
            name="inherit_id"
            ref="spreadsheet_oca.spreadsheet_spreadsheet_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_open_input_params"
                    icon="fa-sliders"
                >
                    <field
                        string="Input Parameters"
                        name="input_param_count"
                        widget="statinfo"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
